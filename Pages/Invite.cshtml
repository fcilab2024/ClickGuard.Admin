@page
@model ClickGuard.Admin.Pages.InviteModel
@{
    ViewData["Title"] = "Accept Invite";
}

<h2>Accept Invite</h2>

<div class="text-danger">@Html.ValidationSummary()</div>

@if (!Model.Valid)
{
    <div class="alert alert-danger">
        This invite is invalid or already used.
    </div>
}
else
{
    <p>Creating account for: <strong>@Model.InviteEmail</strong></p>

    <form method="post">
        <input type="hidden" asp-for="Token" />

        <div class="form-group">
            <label>Password</label>
            <input asp-for="Password" class="form-control" type="password" />
        </div>

        <div class="form-group mt-2">
            <label>Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Create Account</button>
        </div>
    </form>
}