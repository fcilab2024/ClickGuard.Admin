@page
@model ClickGuard.Admin.Pages.Admin.InvitesModel
@{
    ViewData["Title"] = "Invites";
}

<h2>Invites</h2>

<div class="text-danger">@Html.ValidationSummary()</div>

<p>
    <strong>Tenant:</strong> @Model.Tenant.Name (@Model.TenantId)
</p>

<hr />

<h4>Create Invite (One-time use)</h4>

<form method="post" asp-page-handler="Create">
    <input type="hidden" asp-for="TenantId" />

    <div class="form-group">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="form-group mt-2">
        <label>Role</label>
        <select asp-for="Role" class="form-control">
            <option>Admin</option>
            <option>ReadOnly</option>
        </select>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Generate Invite Link</button>
        <a asp-page="/Admin/Tenants" class="btn btn-secondary">Back to Tenants</a>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.NewInviteLink))
{
    <hr />
    <div class="alert alert-success">
        <div><strong>Invite link (shown once):</strong></div>
        <code>@Model.NewInviteLink</code>
    </div>
}

<hr />

<h4>Existing Invites</h4>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Created</th>
            <th>Used</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var i in Model.Invites)
    {
        <tr>
            <td>@i.Email</td>
            <td>@i.Role</td>
            <td>@i.CreatedAt.ToString("u")</td>
            <td>@(i.UsedAt == null ? "No" : $"Yes ({i.UsedAt.Value:u})")</td>
        </tr>
    }
    </tbody>
</table>